{
  "name": "paykka-ai-review",
  "version": "1.0.0",
  "description": "基于 AI 的 Git 暂存区代码审查 CLI 工具，commit 前自动拦截并审查代码变更",
  "type": "module",
  "license": "MIT",
  "bin": {
    "paykka-ai-review": "./dist/paykka-ai-review.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-code-review",
    "code-review",
    "git",
    "cli",
    "deepseek"
  ],
  "scripts": {
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "print-config": "tsx src/index.ts print-config",
    "test-api": "tsx src/index.ts test-api",
    "review": "tsx src/index.ts review",
    "mcp-list": "tsx src/index.ts mcp-list",
    "init": "tsx src/index.ts init"
  },
  "dependencies": {
    "@babel/parser": "^7.27.2",
    "@babel/types": "^7.27.1",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
