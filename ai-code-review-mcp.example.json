{
  "providers": [
    {
      "id": "yuque",
      "label": "语雀文档",
      "transport": {
        "type": "http",
        "url": "语雀 MCP 服务地址"
      },
      "toolName": "yuque_get_doc_by_url"
    },
    {
      "id": "tapd",
      "label": "TAPD 需求",
      "transport": {
        "type": "http",
        "url": "TAPD MCP 服务地址"
      },
      "toolName": "getStories",
      "inputParsing": [
        { "field": "workspaceId", "regex": "从 URL 提取项目 ID 的正则" },
        { "field": "storyId", "regex": "从 URL 提取需求 ID 的正则" }
      ],
      "toolArgs": { "workspace_id": "${workspaceId}", "story_id": "${storyId}" }
    }
  ]
}
